  "stage": "in_progress",
  "history": [
    {
      "revision": 1,
      "stage": "draft",
      "note": "In praxis-core (since 2049bf6) and praxis-runtime (since 393634b) the root vitest.config.ts declares setupFiles ['./vitest.setup.ts']. Vitest resolves it against the workspace cwd, so every 'npm test' workspace run fails with 'Cannot find module packages/<ws>/vitest.setup.ts' before any test executes. .project quality.test is 'npm test', so Quality cannot obtain a passing test signal. Reproduced 2026-10-20."
    },
    {
      "revision": 2,
      "stage": "in_progress",
      "note": "ba → architect"
    }
  ]
