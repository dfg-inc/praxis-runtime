# Praxis Jira / Quality local env (no secrets).
# Copy to .env.praxis.local (gitignored).

PRAXIS_JIRA_MODE=cloud
PRAXIS_JIRA_BASE_URL=
PRAXIS_JIRA_PROJECT_KEY=
PRAXIS_JIRA_EMAIL=
PRAXIS_JIRA_TOKEN=

PRAXIS_JIRA_EPIC_TYPE=Epic
PRAXIS_JIRA_STORY_TYPE=Story
PRAXIS_JIRA_TASK_TYPE=Task
PRAXIS_JIRA_BUG_TYPE=Bug
# Optional Cloud/DC type ids (preferred over localized display names):
# PRAXIS_JIRA_EPIC_TYPE_ID=
# PRAXIS_JIRA_STORY_TYPE_ID=
# PRAXIS_JIRA_TASK_TYPE_ID=
# PRAXIS_JIRA_BUG_TYPE_ID=

PRAXIS_WORK_PACKAGE_MAX_HOURS=16

PRAXIS_QUALITY_URL=http://127.0.0.1:8792
PRAXIS_QA_ALLOW_TEST_WRITES=0
