{
  "name": "praxis-runtime",
  "private": true,
  "version": "0.1.0-alpha.47",
  "description": "Praxis Runtime Desktop Extension (MCPB) and Quality HTTP worker",
  "workspaces": [
    "packages/*",
    "apps/*",
    "tools/scripts"
  ],
  "scripts": {
    "build": "npm run build -w @praxis/mcp -w @praxis/quality-service --if-present",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "pack:mcpb": "node tools/scripts/pack-claude-extension.mjs --version 0.1.0-alpha.47",
    "accept:git-delivery": "node tools/scripts/git-delivery-acceptance.mjs",
    "accept:git-delivery-e2e": "node tools/scripts/git-delivery-e2e-acceptance.mjs",
    "accept:quality-startup": "node tools/scripts/quality-startup-acceptance.mjs",
    "accept:quality-review": "node tools/scripts/quality-review-acceptance.mjs",
    "accept:quality-apply": "node tools/scripts/quality-apply-acceptance.mjs",
    "accept:quality-state-consistency": "node tools/scripts/quality-state-consistency-acceptance.mjs",
    "accept:quality-readback": "node tools/scripts/quality-readback-acceptance.mjs",
    "accept:mcpb-runtime": "node tools/scripts/mcpb-runtime-acceptance.mjs",
    "accept:workflow": "npm run build -w @praxis/mcp && node tools/scripts/workflow-external-acceptance.mjs",
    "accept:stories": "npm run build -w @praxis/mcp && node tools/scripts/story-quality-acceptance.mjs",
    "accept:generic": "npm run build -w @praxis/mcp && node tools/scripts/generic-quality-acceptance.mjs",
    "verify": "npm run build && npm run typecheck && npm run test && npm run check:tests && npm run pack:mcpb && npm run accept:git-delivery && npm run accept:git-delivery-e2e && npm run accept:quality-startup && npm run accept:quality-review && npm run accept:quality-apply && npm run accept:quality-state-consistency && npm run accept:quality-readback && npm run accept:mcpb-runtime",
    "check:version": "node tools/scripts/check-ecosystem-version.mjs",
    "check:tests": "node tools/scripts/check-test-completeness.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@praxis/contracts": "file:vendor/praxis-contracts-0.1.0-alpha.47.tgz",
    "@praxis/project-config": "file:vendor/praxis-project-config-0.1.0-alpha.47.tgz",
    "@praxis/knowledge": "file:vendor/praxis-knowledge-0.1.0-alpha.47.tgz",
    "@praxis/jira": "file:vendor/praxis-jira-0.1.0-alpha.47.tgz",
    "@praxis/vcs": "file:vendor/praxis-vcs-0.1.0-alpha.47.tgz",
    "@praxis/cli": "file:vendor/praxis-cli-0.1.0-alpha.47.tgz"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dfg-inc/praxis-runtime.git"
  },
  "bugs": {
    "url": "https://github.com/dfg-inc/praxis-runtime/issues"
  },
  "homepage": "https://github.com/dfg-inc/praxis-runtime"
}
